{
  "icon": "./src/assets/icon.png",
  "expo": {
    "name": "nutriScan",
    "slug": "nutriscan",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "android": {
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "package": "com.anonymous.nutriscan"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.nutriscan"
    }
  }
}
